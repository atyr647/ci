+#[unsafe(no_mangle)]
+#[cfg(all(feature = "wasi", feature = "component-model-async"))]
+pub unsafe extern "C" fn wasmtime_component_linker_add_wasip3(
+    linker: &mut wasmtime_component_linker_t,
+) -> Option<Box<wasmtime_error_t>> {
+    let result = wasmtime_wasi::p3::add_to_linker(&mut linker.linker);
+    crate::handle_result(result, |_| ())
+}
