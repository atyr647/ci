# CMake toolchain: single-arch Cosmopolitan compilers. COSMO_ARCH = x86_64 (default) or aarch64.
set(COSMO_ARCH $ENV{COSMO_ARCH})
if(NOT COSMO_ARCH)
  set(COSMO_ARCH x86_64)
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR ${COSMO_ARCH})
set(COSMO $ENV{HOME}/cosmo/bin)
set(CMAKE_C_COMPILER   ${COSMO}/${COSMO_ARCH}-unknown-cosmo-cc)
set(CMAKE_CXX_COMPILER ${COSMO}/${COSMO_ARCH}-unknown-cosmo-c++)
set(CMAKE_AR           ${COSMO}/${COSMO_ARCH}-linux-cosmo-ar)
set(CMAKE_RANLIB       ${COSMO}/${COSMO_ARCH}-linux-cosmo-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
