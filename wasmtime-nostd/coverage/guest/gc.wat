;; WebAssembly GC: structs, arrays, i31, casts, a linked structure and an allocation loop that forces collections
(module
  (type $pt (struct (field $x (mut i32)) (field $y (mut i32))))
  (type $arr (array (mut i32)))
  (type $node (struct (field $v i32) (field $next (ref null $node))))
  (type $bytes (array (mut i8)))
  (type $f (func (result i32)))
  (func $seven (result i32) (i32.const 7))
  (elem declare func $seven)

  (func (export "t_struct") (result i32)
    (local $p (ref $pt))
    (local.set $p (struct.new $pt (i32.const 3) (i32.const 4)))
    (struct.set $pt $x (local.get $p) (i32.const 10))
    (i32.eq (i32.add (struct.get $pt $x (local.get $p)) (struct.get $pt $y (local.get $p))) (i32.const 14)))

  (func (export "t_array") (result i32)
    (local $a (ref $arr)) (local $i i32) (local $s i32)
    (local.set $a (array.new $arr (i32.const 7) (i32.const 100)))
    (array.set $arr (local.get $a) (i32.const 5) (i32.const 1000))
    (loop $l
      (local.set $s (i32.add (local.get $s) (array.get $arr (local.get $a) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 100))))
    (i32.and (i32.eq (array.len (local.get $a)) (i32.const 100)) (i32.eq (local.get $s) (i32.const 1693))))

  (func (export "t_array_fixed") (result i32)
    (local $a (ref $arr))
    (local.set $a (array.new_fixed $arr 4 (i32.const 1) (i32.const 2) (i32.const 3) (i32.const 4)))
    (i32.eq (i32.add (array.get $arr (local.get $a) (i32.const 0)) (array.get $arr (local.get $a) (i32.const 3))) (i32.const 5)))

  (func (export "t_array_copy_fill") (result i32)
    (local $a (ref $bytes)) (local $b (ref $bytes))
    (local.set $a (array.new $bytes (i32.const 1) (i32.const 16)))
    (local.set $b (array.new_default $bytes (i32.const 16)))
    (array.copy $bytes $bytes (local.get $b) (i32.const 4) (local.get $a) (i32.const 0) (i32.const 8))
    (array.fill $bytes (local.get $b) (i32.const 12) (i32.const 9) (i32.const 4))
    (i32.eq (i32.add (i32.add (array.get_u $bytes (local.get $b) (i32.const 0)) (array.get_u $bytes (local.get $b) (i32.const 5))) (array.get_u $bytes (local.get $b) (i32.const 15))) (i32.const 10)))

  (func (export "t_i31") (result i32)
    (local $r i31ref)
    (local.set $r (ref.i31 (i32.const -5)))
    (i32.and (i32.eq (i31.get_s (local.get $r)) (i32.const -5)) (i32.eq (i31.get_u (local.get $r)) (i32.const 0x7ffffffb))))

  (func (export "t_cast") (result i32)
    (local $a anyref) (local $score i32)
    (local.set $a (struct.new $pt (i32.const 1) (i32.const 2)))
    (if (ref.test (ref $pt) (local.get $a)) (then (local.set $score (i32.add (local.get $score) (i32.const 1)))))
    (if (ref.test (ref $arr) (local.get $a)) (then (local.set $score (i32.add (local.get $score) (i32.const 100)))))
    (local.set $a (ref.i31 (i32.const 9)))
    (if (ref.test (ref i31) (local.get $a)) (then (local.set $score (i32.add (local.get $score) (i32.const 10)))))
    (local.set $score (i32.add (local.get $score) (i31.get_s (ref.cast (ref i31) (local.get $a)))))
    (i32.eq (local.get $score) (i32.const 20)))

  (func (export "x_bad_cast") (result i32)
    (drop (ref.cast (ref $arr) (struct.new $pt (i32.const 1) (i32.const 2))))
    (i32.const 1))

  (func (export "x_array_oob") (result i32)
    (array.get $arr (array.new_default $arr (i32.const 3)) (i32.const 3)))

  (func (export "t_br_on_cast") (result i32)
    (local $a anyref)
    (local.set $a (struct.new $pt (i32.const 5) (i32.const 6)))
    (block $yes (result (ref $pt))
      (br_on_cast $yes anyref (ref $pt) (local.get $a))
      (drop)
      (return (i32.const 0)))
    (struct.get $pt $y)
    (i32.eq (i32.const 6)))

  (func (export "t_call_ref") (result i32)
    (i32.eq (call_ref $f (ref.func $seven)) (i32.const 7)))

  (func (export "t_linked_list") (result i32)
    (local $head (ref null $node)) (local $i i32) (local $s i32) (local $p (ref null $node))
    (loop $l
      (local.set $head (struct.new $node (local.get $i) (local.get $head)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 1000))))
    (local.set $p (local.get $head))
    (block $done (loop $w
      (br_if $done (ref.is_null (local.get $p)))
      (local.set $s (i32.add (local.get $s) (struct.get $node $v (local.get $p))))
      (local.set $p (struct.get $node $next (local.get $p)))
      (br $w)))
    (i32.eq (local.get $s) (i32.const 499500)))

  ;; allocation stress, not a pass/fail test: allocates n small objects and keeps only the last; returns a checksum (needs a collector that frees)
  (func (export "s_gcstress") (param $n i64) (result i64)
    (local $i i64) (local $keep (ref null $pt)) (local $sum i64)
    (loop $l
      (local.set $keep (struct.new $pt (i32.wrap_i64 (local.get $i)) (i32.const 1)))
      (local.set $sum (i64.add (local.get $sum) (i64.extend_i32_u (struct.get $pt $x (local.get $keep)))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $l (i64.lt_u (local.get $i) (local.get $n))))
    (local.get $sum))
  (func (export "s_gcstress_arrays") (param $n i64) (result i64)
    (local $i i64) (local $sum i64)
    (loop $l
      (local.set $sum (i64.add (local.get $sum) (i64.extend_i32_u (array.len (array.new $arr (i32.const 1) (i32.const 64))))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $l (i64.lt_u (local.get $i) (local.get $n))))
    (local.get $sum))
)
