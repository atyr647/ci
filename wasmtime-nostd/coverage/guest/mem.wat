;; memory64 and multi-memory
(module
  (memory $m64 (export "memory") i64 1)
  (memory $a 1)
  (memory $b 1)
  (data $d (memory $b) (i32.const 0) "ABCDEFGH")

  (func (export "t_mem64_load_store") (result i32)
    (i64.store $m64 (i64.const 8) (i64.const 0x1122334455667788))
    (i64.eq (i64.load $m64 (i64.const 8)) (i64.const 0x1122334455667788)))
  (func (export "t_mem64_size_grow") (result i32)
    (local $old i64)
    (local.set $old (memory.grow $m64 (i64.const 2)))
    (i32.and (i64.eq (local.get $old) (i64.const 1)) (i64.eq (memory.size $m64) (i64.const 3))))
  (func (export "t_mem64_fill_copy") (result i32)
    (memory.fill $m64 (i64.const 100) (i32.const 0x5a) (i64.const 50))
    (memory.copy $m64 $m64 (i64.const 200) (i64.const 100) (i64.const 50))
    (i32.eq (i32.load8_u $m64 (i64.const 249)) (i32.const 0x5a)))
  (func (export "x_mem64_high_address") (result i32)
    (i32.load $m64 (i64.const 0x100000000)))
  (func (export "x_mem64_oob_last_page") (result i32)
    (i32.load $m64 (i64.sub (i64.mul (memory.size $m64) (i64.const 65536)) (i64.const 2))))

  (func (export "t_multi_two_memories") (result i32)
    (i32.store $a (i32.const 0) (i32.const 111))
    (i32.store $b (i32.const 100) (i32.const 222))
    (i32.eq (i32.add (i32.load $a (i32.const 0)) (i32.load $b (i32.const 100))) (i32.const 333)))
  (func (export "t_multi_copy_between") (result i32)
    (memory.copy $a $b (i32.const 16) (i32.const 0) (i32.const 8))
    (i32.eq (i32.load8_u $a (i32.const 18)) (i32.const 67)))
  (func (export "t_multi_grow_independent") (result i32)
    (drop (memory.grow $a (i32.const 3)))
    (i32.and (i32.eq (memory.size $a) (i32.const 4)) (i32.eq (memory.size $b) (i32.const 1))))
  (func (export "t_multi_mixed_64_and_32") (result i32)
    (memory.copy $m64 $b (i64.const 300) (i32.const 0) (i32.const 8))
    (i32.eq (i32.load8_u $m64 (i64.const 303)) (i32.const 68)))
)
