;; async: a host function that suspends the fiber; a loop of suspensions; and the same loop with a synchronous host function for comparison
(module
  (import "env" "yield_n" (func $yield_n (param i32)))
  (import "env" "sync_nop" (func $sync_nop (param i32)))
  (func (export "t_one_suspension") (result i32) (call $yield_n (i32.const 1)) (i32.const 1))
  (func (export "t_many_in_loop") (result i32)
    (local $i i32)
    (loop $l (call $yield_n (i32.const 2)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $l (i32.lt_u (local.get $i) (i32.const 100))))
    (i32.eq (local.get $i) (i32.const 100)))
  (func $rec (param $d i32) (result i32)
    (if (result i32) (i32.eqz (local.get $d)) (then (call $yield_n (i32.const 1)) (i32.const 1)) (else (i32.add (call $rec (i32.sub (local.get $d) (i32.const 1))) (i32.const 1)))))
  (func (export "t_suspend_deep_stack") (result i32) (i32.eq (call $rec (i32.const 200)) (i32.const 201)))
  (func (export "x_trap_after_suspension") (result i32) (call $yield_n (i32.const 1)) (unreachable))
  (func (export "s_async_loop") (param $n i64) (result i64)
    (local $i i64)
    (loop $l (call $yield_n (i32.const 1)) (local.set $i (i64.add (local.get $i) (i64.const 1))) (br_if $l (i64.lt_u (local.get $i) (local.get $n))))
    (local.get $i))
  (func (export "s_sync_loop") (param $n i64) (result i64)
    (local $i i64)
    (loop $l (call $sync_nop (i32.const 1)) (local.set $i (i64.add (local.get $i) (i64.const 1))) (br_if $l (i64.lt_u (local.get $i) (local.get $n))))
    (local.get $i))
  ;; deep recursion on the fiber stack must trap cleanly (stack overflow), not crash
  (func $inf (param i32) (result i32) (i32.add (call $inf (i32.add (local.get 0) (i32.const 1))) (i32.const 1)))
  (func (export "x_stack_overflow_on_fiber") (result i32) (call $inf (i32.const 0)))
)
