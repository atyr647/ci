+// Thread parking is provided by the embedder (C platform layer): the check of the value and the
+// blocking are atomic with respect to `wn_atomic_notify`. `size` is 4 or 8, `timeout_ns` < 0 means
+// no timeout. Returns 0 (woken by a notify), 1 (value mismatch), 2 (timed out).
+unsafe extern "C" {
+    fn wn_atomic_wait(addr: *const u8, size: u32, expected: u64, timeout_ns: i64) -> i32;
+    fn wn_atomic_notify(addr: *const u8, count: u32) -> u32;
+}
+
+fn wait_result(r: i32) -> WaitResult {
+    match r {
+        0 => WaitResult::Ok,
+        1 => WaitResult::Mismatch,
+        _ => WaitResult::TimedOut,
+    }
+}
+
+fn timeout_ns(timeout: Option<Duration>) -> i64 {
+    match timeout {
+        Some(d) => i64::try_from(d.as_nanos()).unwrap_or(i64::MAX),
+        None => -1,
+    }
+}
