# dbus: the message bus the shell, Settings, the login screen and the system services talk on (dbus-daemon, the
# library, dbus-send and the other tools). The system bus listens on /run/dbus/system_bus_socket and runs as the
# account dbus (base-files); services are started by the bus from /usr/share/dbus-1 (traditional activation).
# Without systemd, SELinux, AppArmor, audit, its documentation and its tests (each named off). Its starting at boot
# is Ribbon's service, not this kit's.
name=dbus
kit=org.freedesktop.dbus
version=1.16.4
revision=1
summary="The D-Bus message bus"
license="AFL-2.1 OR GPL-2.0-or-later"
source="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.4.tar.xz"
sha256="d08b05526c2cb7966a5fb79210d6112b1aca3d135f315c1b302e14b4b0297dac"
srcdir="dbus-1.16.4"
needs="org.gnu.glibc io.github.libexpat.expat"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz io.github.pkgconf.pkgconf com.mesonbuild.meson io.github.michaelforney.samurai org.python.python io.github.libexpat.expat"

build() {
	meson setup build --prefix=/usr --libdir=lib --libexecdir=lib/dbus-1.0 --sbindir=bin --sysconfdir=/etc \
		--localstatedir=/var --buildtype=plain --wrap-mode=nodownload -Ddefault_library=shared \
		-Druntime_dir=/run -Dsystem_socket=/run/dbus/system_bus_socket -Dsystem_pid_file=/run/dbus/pid \
		-Ddbus_user=dbus -Dtraditional_activation=true -Dmessage_bus=true -Dtools=true -Duser_session=false \
		-Depoll=enabled -Dinotify=enabled -Dkqueue=disabled -Dlaunchd=disabled -Dsystemd=disabled \
		-Dselinux=disabled -Dapparmor=disabled -Dlibaudit=disabled -Dvalgrind=disabled -Ddoxygen_docs=disabled \
		-Dxml_docs=disabled -Dducktype_docs=disabled -Dqt_help=disabled -Dmodular_tests=disabled \
		-Dinstalled_tests=false -Dintrusive_tests=false
	samu -C build -j"$JOBS"
}

stage() {
	DESTDIR="$DESTDIR" meson install -C build --no-rebuild
	# what dbus-daemon makes at run time (its pid, socket and machine id) is not the kit's
	rm -rf "$DESTDIR/run" "$DESTDIR/var/run"
	# the system bus starts services through this helper, as root; a kit's files carry no group (upstream makes it
	# 4750 root:dbus), so it is 4755: the helper itself refuses anyone but the dbus account (check_permissions)
	chmod 4755 "$DESTDIR/usr/lib/dbus-1.0/dbus-daemon-launch-helper"
}
