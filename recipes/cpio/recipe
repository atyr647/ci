# cpio: the archive format an initramfs is in; dracut makes one with it.
name=cpio
kit=org.gnu.cpio
version=2.15
revision=1
summary="The cpio archiver"
license="GPL-3.0-or-later"
source="https://ftp.gnu.org/gnu/cpio/cpio-2.15.tar.bz2"
sha256="937610b97c329a1ec9268553fb780037bcfff0dcffe9725ebc4fd9c1aa9075db"
srcdir="cpio-2.15"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

build() {
	# cpio 2.15 declares functions without their parameters, which gcc 15 (C23 by default) refuses: built as C17
	./configure --prefix=/usr --disable-nls --disable-mt --with-rmt=/usr/bin/rmt CFLAGS="$CFLAGS -std=gnu17"
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
