# autoconf: makes configure scripts; a build from a source tree without one (erofs-utils' snapshot) needs it.
name=autoconf
kit=org.gnu.autoconf
version=2.73
revision=1
summary="Makes configure scripts"
license="GPL-3.0-or-later"
source="https://ftp.gnu.org/gnu/autoconf/autoconf-2.73.tar.xz"
sha256="9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e"
srcdir="autoconf-2.73"
needs="org.gnu.m4 org.perl.perl"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz org.gnu.m4 org.perl.perl"

build() {
	./configure --prefix=/usr
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
