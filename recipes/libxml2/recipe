# libxml2: XML (labwc's rc.xml and themes, Wayland's protocol check). Without Python, ICU, compression, readline
# and the network (HTTP, FTP), each named off.
name=libxml2
kit=org.gnome.libxml2
version=2.13.8
revision=1
summary="XML parsing"
license="MIT"
source="https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.8.tar.xz"
sha256="277294cb33119ab71b2bc81f2f445e9bc9435b893ad15bb2cd2b0e859a0ee84a"
srcdir="libxml2-2.13.8"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz io.github.pkgconf.pkgconf"

# autotools, not meson: libxml2's meson.build runs git (for a version suffix) and stops where there is none
build() {
	./configure --prefix=/usr --bindir=/usr/bin --libdir=/usr/lib --disable-static --without-python --without-icu \
		--without-lzma --without-zlib --without-readline --without-history --without-http --without-ftp \
		--with-iconv --with-threads
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
