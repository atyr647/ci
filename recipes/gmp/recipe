# gmp: the compiler needs it. Without its C++ library (libgmpxx): that loads gcc's run-time libraries, and gcc's
# kit needs gmp's, so gmp would need gcc and gcc gmp; nothing in the base set uses it (gcc uses the C library).
name=gmp
kit=org.gmplib.gmp
version=6.3.0
revision=1
summary="The GNU multiple precision arithmetic library"
license="LGPL-3.0-or-later OR GPL-2.0-or-later"
source="https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz"
sha256="a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898"
srcdir="gmp-6.3.0"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz org.gnu.m4"

build() {
	# gmp 6.3.0's configure has a test that GCC 15 (C23) refuses (Linux From Scratch 12.4's edit)
	sed -i '/long long t1;/,+1s/()/(...)/' configure
	# a library for every x86-64 processor, which picks its routines when it starts: not one fitted to the machine
	# that built it
	./configure --prefix=/usr --build=x86_64-pc-linux-gnu --enable-fat --disable-static
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
