# libcap: POSIX capabilities (libcap, libpsx, capsh, getcap, setcap); dinit gives services their capabilities with it.
# Without the PAM module and the Go binding.
name=libcap
kit=org.kernel.libcap
version=2.78
revision=1
summary="POSIX capabilities library and tools"
license="BSD-3-Clause OR GPL-2.0-only"
source="https://cdn.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.78.tar.xz"
sha256="0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11"
srcdir="libcap-2.78"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

cmake_() { make prefix=/usr lib=lib sbindir=bin GOLANG=no PAM_CAP=no RAISE_SETFCAP=no "$@"; }
build() { cmake_ -j"$JOBS"; }

stage() {
	cmake_ DESTDIR="$DESTDIR" install
	rm -f "$DESTDIR"/usr/lib/libcap.a "$DESTDIR"/usr/lib/libpsx.a
}
