# samurai: samu, a ninja-compatible build tool in C, which meson runs (it looks for samu as well as ninja). ninja
# itself is not used: its only source download, GitHub's archive of the tag, is refused here. The checksum is the
# release file's as downloaded on 22 Nov; other distributions build from the tag archive, so nothing confirms it
# (decision 139).
name=samurai
kit=io.github.michaelforney.samurai
version=1.3
revision=1
summary="A ninja-compatible build tool"
license="Apache-2.0 AND MIT"
source="https://github.com/michaelforney/samurai/releases/download/1.3/samurai-1.3.tar.gz"
sha256="1bc020a9e133432df51911ac71cc34322f828934d9a2282ba2916d88c15976af"
srcdir="samurai-1.3"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

build() { make -j"$JOBS" CC=cc CFLAGS="$CFLAGS"; }

stage() { make CC=cc PREFIX=/usr MANDIR=/usr/share/man DESTDIR="$DESTDIR" install; }
