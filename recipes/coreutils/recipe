# coreutils: ls, cp, cat and the hundred others, with hostname; kill and uptime are another package's (procps).
# Without gmp (expr and factor count in machine integers). The patch is upstream's fix for sort's read before its
# buffer (bugs.gnu.org 78507, after 9.7), the source change alone. Its build makes the manual pages with perl.
name=coreutils
kit=org.gnu.coreutils
version=9.7
revision=1
summary="The GNU core utilities"
license="GPL-3.0-or-later"
source="https://ftp.gnu.org/gnu/coreutils/coreutils-9.7.tar.xz"
sha256="e8bb26ad0293f9b5a1fc43fb42ba970e312c66ce92c1b0b16713d7500db251bf"
srcdir="coreutils-9.7"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz org.perl.perl"

build() {
	FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=/usr --sbindir=/usr/bin --without-libgmp \
		--enable-install-program=hostname --enable-no-install-program=kill,uptime
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
