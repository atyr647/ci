S=/run/build/src
NEW=/run/build/new
TGT=x86_64-ribbon-linux-gnu

# cross NAME [CONFIGURE-ARGUMENT...]: one of the usual tools, cross-compiled into the new root
cross() {
	_n=$1; shift
	echo "==== $_n"
	cd "$S/$_n"
	_guess=build-aux/config.guess; [ -f "$_guess" ] || _guess=support/config.guess; [ -f "$_guess" ] || _guess=config.guess
	./configure --prefix=/usr --sbindir=/usr/bin --host="$TGT" --build="$(sh "$_guess")" --disable-nls "$@"
	make -j"$JOBS"
	make DESTDIR="$NEW" install
}

build() {
	umask 022
	# the new root: a merged /usr
	mkdir -p "$NEW/usr/bin" "$NEW/usr/lib" "$NEW/tools" "$NEW/etc" "$NEW/var"
	ln -s usr/bin "$NEW/bin"; ln -s usr/bin "$NEW/sbin"; ln -s usr/lib "$NEW/lib"; ln -s usr/lib "$NEW/lib64"
	PATH=$NEW/tools/bin:$PATH
	CONFIG_SITE=$NEW/usr/share/config.site
	FORCE_UNSAFE_CONFIGURE=1
	export PATH CONFIG_SITE FORCE_UNSAFE_CONFIGURE

	echo "==== binutils, first pass (the cross linker and assembler)"
	mkdir "$S/binutils-2.45/build1"; cd "$S/binutils-2.45/build1"
	../configure --prefix="$NEW/tools" --with-sysroot="$NEW" --target="$TGT" --disable-nls --enable-gprofng=no \
		--disable-werror --enable-new-dtags --enable-default-hash-style=gnu --enable-deterministic-archives
	make -j"$JOBS"
	# into tools/ itself: the builder's DESTDIR is for stage()
	make DESTDIR= install

	echo "==== gcc, first pass (the cross compiler, no C library yet)"
	cd "$S/gcc-15.2.0"
	mv ../gmp-6.3.0 gmp; mv ../mpfr-4.2.2 mpfr; mv ../mpc-1.3.1 mpc
	# 64-bit libraries go to lib, not lib64
	sed -e '/m64=/s/lib64/lib/' -i gcc/config/i386/t-linux64
	mkdir build1; cd build1
	../configure --target="$TGT" --prefix="$NEW/tools" --with-glibc-version=2.42 --with-sysroot="$NEW" --with-newlib \
		--without-headers --enable-default-pie --enable-default-ssp --disable-nls --disable-shared --disable-multilib \
		--disable-threads --disable-libatomic --disable-libgomp --disable-libquadmath --disable-libssp --disable-libvtv \
		--disable-libstdcxx --enable-languages=c,c++
	make -j"$JOBS"
	make DESTDIR= install
	cd ..
	cat gcc/limitx.h gcc/glimits.h gcc/limity.h > "$(dirname "$("$TGT-gcc" -print-libgcc-file-name)")/include/limits.h"

	echo "==== the kernel's headers"
	cd "$S/linux-6.18"
	xz -dc ../patch-6.18.64.xz | patch -s -p1
	make mrproper
	make -j"$JOBS" headers
	find usr/include -type f ! -name '*.h' -delete
	cp -r usr/include "$NEW/usr"

	echo "==== glibc"
	mkdir "$S/glibc-2.42/build"; cd "$S/glibc-2.42/build"
	echo "rootsbindir=/usr/bin" > configparms
	echo "sbindir=/usr/bin" >> configparms
	../configure --prefix=/usr --host="$TGT" --build="$(../scripts/config.guess)" --disable-nscd \
		libc_cv_slibdir=/usr/lib libc_cv_rtlddir=/usr/lib --enable-kernel=5.4
	make -j"$JOBS"
	make DESTDIR="$NEW" install
	sed '/RTLDLIST=/s@/usr@@g' -i "$NEW/usr/bin/ldd"
	# the cross compiler makes a program that names the new C library's loader
	echo 'int main(){}' | "$TGT-gcc" -x c - -v -Wl,--verbose -o /run/build/try > /run/build/try.log 2>&1
	readelf -l /run/build/try | grep -q 'interpreter: /lib64/ld-linux-x86-64.so.2' || { echo "the cross compiler's programs do not name /lib64/ld-linux-x86-64.so.2" >&2; exit 1; }
	grep -q "open $NEW/usr/lib/libc.so.6 succeeded" /run/build/try.log || { echo "the cross linker does not take the new C library" >&2; exit 1; }

	echo "==== libstdc++ (for the cross compiler)"
	mkdir "$S/gcc-15.2.0/buildxx"; cd "$S/gcc-15.2.0/buildxx"
	../libstdc++-v3/configure --host="$TGT" --build="$(../config.guess)" --prefix=/usr --disable-multilib --disable-nls \
		--disable-libstdcxx-pch --with-gxx-include-dir="/tools/$TGT/include/c++/15.2.0"
	make -j"$JOBS"
	make DESTDIR="$NEW" install
	rm -f "$NEW"/usr/lib/libstdc++.la "$NEW"/usr/lib/libstdc++exp.la "$NEW"/usr/lib/libstdc++fs.la "$NEW"/usr/lib/libsupc++.la

	cross m4-1.4.20
	cross bash-5.3 --without-bash-malloc
	ln -s bash "$NEW/usr/bin/sh"
	cross coreutils-9.7 --enable-install-program=hostname --enable-no-install-program=kill,uptime
	cross diffutils-3.12 gl_cv_func_strcasecmp_works=y
	cross findutils-4.10.0 --localstatedir=/var/lib/locate
	sed -i 's/extras//' "$S/gawk-5.3.2/Makefile.in"
	cross gawk-5.3.2
	cross grep-3.12
	cross gzip-1.14
	cross make-4.4.1 --without-guile
	cross patch-2.8
	cross sed-4.9
	cross tar-1.35
	cross xz-5.8.1 --disable-static --disable-doc

	echo "==== binutils, second pass (the new root's own)"
	cd "$S/binutils-2.45"
	# libtool must not link the host's libraries into a cross-built ld
	grep -n '\$add_dir' ltmain.sh | grep -q '^6031:' || { echo "binutils' ltmain.sh is not the one the edit was written for" >&2; exit 1; }
	sed '6031s/$add_dir//' -i ltmain.sh
	mkdir build2; cd build2
	../configure --prefix=/usr --sbindir=/usr/bin --build="$(../config.guess)" --host="$TGT" --disable-nls --enable-shared \
		--enable-gprofng=no --disable-werror --enable-64-bit-bfd --enable-new-dtags --enable-default-hash-style=gnu \
		--enable-deterministic-archives
	make -j"$JOBS"
	make DESTDIR="$NEW" install
	for l in bfd ctf ctf-nobfd opcodes sframe; do rm -f "$NEW/usr/lib/lib$l.a" "$NEW/usr/lib/lib$l.la"; done

	echo "==== gcc, second pass (the new root's own compiler)"
	cd "$S/gcc-15.2.0"
	sed '/thread_header =/s/@.*@/gthr-posix.h/' -i libgcc/Makefile.in libstdc++-v3/include/Makefile.in
	mkdir build2; cd build2
	../configure --build="$(../config.guess)" --host="$TGT" --target="$TGT" LDFLAGS_FOR_TARGET="-L$PWD/$TGT/libgcc" \
		--prefix=/usr --with-build-sysroot="$NEW" --enable-default-pie --enable-default-ssp --disable-nls \
		--disable-multilib --disable-libatomic --disable-libgomp --disable-libquadmath --disable-libsanitizer \
		--disable-libssp --disable-libvtv --enable-languages=c,c++
	make -j"$JOBS"
	make DESTDIR="$NEW" install
	ln -s gcc "$NEW/usr/bin/cc"
}

stage() {
	# the cross toolchain (tools/) made the root and stays behind; so do the manuals
	rm -rf "$NEW/usr/share/info" "$NEW/usr/share/man" "$NEW/usr/share/doc"
	find "$NEW/usr" -name '*.la' -delete
	# one directory for programs, one for libraries
	if [ -d "$NEW/usr/sbin" ]; then mv "$NEW"/usr/sbin/* "$NEW/usr/bin/"; rmdir "$NEW/usr/sbin"; fi
	if [ -d "$NEW/usr/lib64" ]; then cp -a "$NEW"/usr/lib64/. "$NEW/usr/lib/"; rm -rf "$NEW/usr/lib64"; fi
	mkdir -p "$DESTDIR"
	mv "$NEW/usr" "$DESTDIR/usr"
}
