# bzip2: bzip2, bunzip2, bzcat and libbz2 (the shared library; its Makefile makes a static one by default).
name=bzip2
kit=org.sourceware.bzip2
version=1.0.8
revision=1
summary="The bzip2 compressor and library"
license="bzip2-1.0.6"
source="https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
sha256="ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
srcdir="bzip2-1.0.8"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

build() {
	# links inside the kit, not to this build's directory; manual pages where the others are
	sed -i 's@\(ln -s -f \)$(PREFIX)/bin/@\1@' Makefile
	sed -i 's@(PREFIX)/man@(PREFIX)/share/man@g' Makefile
	make -f Makefile-libbz2_so
	make clean
	make -j"$JOBS"
}

stage() {
	make PREFIX="$DESTDIR/usr" install
	cp -a libbz2.so.* "$DESTDIR/usr/lib/"
	ln -s libbz2.so.1.0.8 "$DESTDIR/usr/lib/libbz2.so"
	# the programs linked to the shared library, in place of the static ones
	install -m755 bzip2-shared "$DESTDIR/usr/bin/bzip2"
	for p in bunzip2 bzcat; do ln -sf bzip2 "$DESTDIR/usr/bin/$p"; done
	rm -f "$DESTDIR/usr/lib/libbz2.a"
}
