# harfbuzz: text shaping (which glyphs, where), for scripts whose letters join or reorder; Tk's right-to-left text
# needs it. With freetype; without glib, cairo, ICU and graphite (each named off), its tools and its tests.
name=harfbuzz
kit=io.github.harfbuzz.harfbuzz
version=15.1.0
revision=1
summary="The HarfBuzz text shaping library"
license="MIT"
source="https://github.com/harfbuzz/harfbuzz/releases/download/15.1.0/harfbuzz-15.1.0.tar.xz"
sha256="0fc7c565443a5f4be7da65ac5ee5bd737d9b158dc908708b7689a0a5796b0c8d"
srcdir="harfbuzz-15.1.0"
needs="org.gnu.glibc org.freetype.freetype"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz io.github.pkgconf.pkgconf com.mesonbuild.meson io.github.michaelforney.samurai org.python.python org.freetype.freetype"

build() {
	meson setup build --prefix=/usr --libdir=lib --buildtype=plain --wrap-mode=nodownload -Ddefault_library=shared \
		-Dfreetype=enabled -Dglib=disabled -Dgobject=disabled -Dcairo=disabled -Dchafa=disabled -Dicu=disabled \
		-Dgraphite2=disabled -Dintrospection=disabled -Ddocs=disabled -Dtests=disabled -Dutilities=disabled
	samu -C build -j"$JOBS"
}

stage() { DESTDIR="$DESTDIR" meson install -C build --no-rebuild; }
