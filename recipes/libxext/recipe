# libxext: the X protocol extensions' common library.
name=libxext
kit=org.x.libxext
version=1.3.7
revision=1
summary="The X extensions' common library"
license="MIT"
source="https://www.x.org/releases/individual/lib/libXext-1.3.7.tar.xz"
sha256="6c643c7035cdacf67afd68f25d01b90ef889d546c9fcd7c0adf7c2cf91e3a32d"
srcdir="libXext-1.3.7"
needs="org.gnu.glibc org.x.libx11"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz io.github.pkgconf.pkgconf org.x.xorgproto org.x.libx11"

build() {
	./configure --prefix=/usr --disable-static --without-xmlto --without-fop --without-xsltproc --disable-specs
	make -j"$JOBS"
}

stage() { make DESTDIR="$DESTDIR" install; }
