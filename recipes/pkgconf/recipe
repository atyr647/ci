# pkgconf: pkg-config, which most libraries' builds use to find each other. pkg-config is a link to pkgconf, and the
# places it looks are Ribbon's one library directory.
name=pkgconf
kit=io.github.pkgconf.pkgconf
version=3.0.11
revision=1
summary="pkg-config, the library finder for builds"
license="ISC"
source="https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.11.tar.xz"
sha256="d0cd841bc8e55b9da888106c00dc256d05b7d1d8e5a46f4be4eb4c5125bd2dc4"
srcdir="pkgconf-3.0.11"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

build() {
	./configure --prefix=/usr --disable-static --with-system-libdir=/usr/lib --with-system-includedir=/usr/include \
		--with-pkg-config-dir=/usr/lib/pkgconfig:/usr/share/pkgconfig
	make -j"$JOBS"
}

stage() {
	make DESTDIR="$DESTDIR" install
	ln -s pkgconf "$DESTDIR/usr/bin/pkg-config"
	ln -s pkgconf.1 "$DESTDIR/usr/share/man/man1/pkg-config.1"
}
