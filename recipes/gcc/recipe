# gcc: the C and C++ compilers with libgcc, libstdc++, libgomp, libatomic, libquadmath and the sanitizers' libraries.
# One kit (decision 82), so a program in C++ needs this whole kit to run until kits can be split. Built as Linux From
# Scratch 12.4 builds it. A compiler needs the kernel's headers and the binary tools beside it: they are its needs.
name=gcc
kit=org.gnu.gcc
version=15.2.0
revision=1
summary="The GNU compilers for C and C++, and their run-time libraries"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
source="https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
sha256="438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e"
srcdir="gcc-15.2.0"
needs="org.gnu.glibc org.gnu.binutils org.gmplib.gmp org.mpfr.mpfr org.multiprecision.mpc net.zlib.zlib org.kernel.linux-headers"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz org.gnu.binutils org.gmplib.gmp org.mpfr.mpfr org.multiprecision.mpc net.zlib.zlib org.kernel.linux-headers"

build() {
	# 64-bit libraries go to /usr/lib, not lib64
	sed -e '/m64=/s/lib64/lib/' -i gcc/config/i386/t-linux64
	mkdir build; cd build
	# no three-stage build of its own: the base set is built three times over (build/kits/bootstrap.sh)
	../configure --prefix=/usr --build=x86_64-pc-linux-gnu LD=ld --enable-languages=c,c++ --enable-default-pie \
		--enable-default-ssp --enable-host-pie --disable-multilib --disable-bootstrap --disable-fixincludes \
		--with-system-zlib
	make -j"$JOBS"
}

stage() {
	cd build
	make DESTDIR="$DESTDIR" install
	ln -s gcc "$DESTDIR/usr/bin/cc"
	# the linker's plugin for link-time optimisation, where ar and nm look for it
	mkdir -p "$DESTDIR/usr/lib/bfd-plugins"
	ln -s ../../libexec/gcc/x86_64-pc-linux-gnu/15.2.0/liblto_plugin.so "$DESTDIR/usr/lib/bfd-plugins/liblto_plugin.so"
	# gdb's helpers do not belong among the libraries
	mkdir -p "$DESTDIR/usr/share/gdb/auto-load/usr/lib"
	mv "$DESTDIR"/usr/lib/*gdb.py "$DESTDIR/usr/share/gdb/auto-load/usr/lib/"
}
