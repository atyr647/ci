# zlib: the shared library and its headers.
name=zlib
kit=net.zlib.zlib
version=1.3.1
revision=1
summary="The zlib compression library"
license="Zlib"
source="https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"
sha256="9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
srcdir="zlib-1.3.1"
needs="org.gnu.glibc"
build_needs="org.gnu.gcc org.gnu.make org.gnu.bash org.gnu.coreutils org.gnu.sed org.gnu.grep org.gnu.gawk org.gnu.findutils org.gnu.diffutils org.gnu.gzip org.gnu.tar org.tukaani.xz"

build() {
	./configure --prefix=/usr
	make -j"$JOBS"
}

stage() {
	make DESTDIR="$DESTDIR" install
	rm -f "$DESTDIR/usr/lib/libz.a"
}
