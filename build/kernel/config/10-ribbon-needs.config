# What Ribbon itself needs from the kernel. Lines that Void's base already has are pinned here all the same, so that
# a newer base that drops one fails the build (kconfig.sh check) instead of shipping a kernel without it.

# erofs with deflate: system kits' images are erofs, compressed with deflate (docs/KIT-round3.md: D38, no zstd in
# any kit); Void builds erofs without the deflate decompressor
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
# a kit's image is mounted through a read-only loop device at its offset, under dm-verity (docs/KIT-FORMAT.md 8)
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_VERITY=m

# sched_ext: Ribbon's default scheduler is scx_lavd (docs/DESIGN.md, config/ribbon.conf); Void's 6.18 has no
# sched_ext, so on Void's kernel the scx service finds nothing to attach to
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# Wine and Proton (docs/DESIGN.md); app kits through FUSE with passthrough reads (mkkitfs); Landlock and user
# namespaces for the kit sandbox; /proc/config.gz, which the boot test reads
CONFIG_NTSYNC=y
CONFIG_FUSE_FS=m
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_USER_NS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# modules are compressed with xz, not zstd (D38), and the kernel decompresses them itself
CONFIG_MODULE_COMPRESS=y
# CONFIG_MODULE_COMPRESS_GZIP is not set
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_DECOMPRESS=y
# firmware may be xz (Ribbon's firmware kits) or zstd (Void's linux-firmware, while it is still installed)
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
