# Ribbon OS defaults for GRUB (used only when GRUB is the boot loader).
# /etc/default/grub sources this file at its end (the installer adds the
# line). The kernel flags and the timeout come from /etc/default/ribbon-boot,
# which every boot loader shares. The installer owns
# GRUB_CMDLINE_LINUX_DEFAULT (disk unlock); Ribbon's own flags go in
# GRUB_CMDLINE_LINUX so they apply to every entry, including snapshot and
# fallback-kernel entries.
[ -r /etc/default/ribbon-boot ] && . /etc/default/ribbon-boot
GRUB_DISTRIBUTOR="Ribbon OS"
GRUB_TIMEOUT=${BOOT_TIMEOUT:-3}
GRUB_TIMEOUT_STYLE=menu
GRUB_CMDLINE_LINUX="${RIBBON_CMDLINE:-} ${RIBBON_CMDLINE_EXTRA:-}"
# Entry 0 is the default kernel; the fallback kernel and snapshots follow.
GRUB_DEFAULT=0
# Ribbon's own kernel (VERSION-ribbon_REVISION), the newest of them, is entry 0 when one is installed: GRUB sorts by
# version, and Void's kernel of the same version would come first (GRUB_TOP_LEVEL, GRUB 2.12)
_ribbon_k=$(ls -1 /boot/vmlinuz-*-ribbon_* 2>/dev/null | sort -V | tail -n1)
[ -z "$_ribbon_k" ] || GRUB_TOP_LEVEL=$_ribbon_k
unset _ribbon_k
GRUB_DISABLE_SUBMENU=y
GRUB_DISABLE_OS_PROBER=false
