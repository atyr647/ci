#!/bin/sh
# /usr/lib/ribbon/sv2dinit/sv-exec <runit-service>
# Runs /etc/sv/<service>/run unmodified under dinit. Because the run script
# ends in `exec <daemon>`, dinit ends up supervising the daemon itself.
sv=$1
dir=${RIBBON_SV_DIR:-/etc/sv}/$sv
cd "$dir" || exit 111
PATH=/usr/lib/ribbon/sv2dinit/compat:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
exec ./run
