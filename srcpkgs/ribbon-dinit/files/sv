#!/bin/sh
# Minimal sv(8) for runit run scripts executed by dinit (Ribbon OS).
# Only on PATH inside generated services; the real sv(8) is untouched.
# Supports: check/status/start/up/once/stop/down/restart [-w N] [-v] NAME...

wait=7   # runit's own default for -w
while [ $# -gt 0 ]; do
	case "$1" in
		-w) wait=$2; shift 2 ;;
		-v) shift ;;
		*) break ;;
	esac
done
cmd=$1
[ $# -gt 0 ] && shift

map_name() {
	for f in /usr/share/ribbon/sv2dinit/map /etc/ribbon/sv2dinit/map; do
		[ -r "$f" ] || continue
		m=$(awk -v n="$1" '$1 == n { print $2; exit }' "$f")
		[ -n "$m" ] && { printf '%s' "$m"; return; }
	done
	printf '%s' "$1"
}

# `sv check`: the service is up and, when it has a ./check, that says it is ready (runit's meaning: ./check exits 0 once the
# service works). Waits up to -w seconds (7), as runit does.
ready() { # runit-name dinit-name
	dinitctl is-started "$2" >/dev/null 2>&1 || return 1
	c=${RIBBON_SV_DIR:-/etc/sv}/$1/check
	[ -x "$c" ] || return 0
	( cd "${c%/check}" && ./check ) >/dev/null 2>&1
}
await() {
	n=0
	while ! ready "$1" "$2"; do
		[ "$n" -lt "$wait" ] || return 1
		n=$((n + 1))
		sleep 1
	done
}

rc=0
for s; do
	rn=${s##*/}
	s=$(map_name "$rn")
	case "$cmd" in
		check|c) await "$rn" "$s" || rc=1 ;;
		status|s) dinitctl is-started "$s" >/dev/null 2>&1 || rc=1 ;;
		start|up|u|once|o) dinitctl start "$s" >/dev/null 2>&1 || rc=1 ;;
		stop|down|d|force-stop) dinitctl stop "$s" >/dev/null 2>&1 || rc=1 ;;
		restart|t|force-restart) dinitctl restart "$s" >/dev/null 2>&1 || rc=1 ;;
		*) echo "sv (ribbon compat): unsupported command '$cmd'" >&2; rc=1 ;;
	esac
done
exit $rc
