# The wallpaper (ribbon-wall: designs, pictures, slideshows, videos), under the user's dinit (HANDOFF robustness 4a).
# Started by labwc's autostart. A crash is restarted after 2 s; after 5 starts within 60 s dinit stops restarting it.
type = process
command = /usr/bin/ribbon-wall
restart = on-failure
restart-delay = 2
restart-limit-count = 5
restart-limit-interval = 60
