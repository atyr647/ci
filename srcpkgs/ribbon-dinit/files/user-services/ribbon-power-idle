# The idle timers' daemon (Settings → Power: power-idle.tcl keeps swayidle running with the current timers). Started
# by labwc's autostart. A crash is restarted after 2 s; after 5 starts within 60 s dinit stops restarting it.
type = process
command = /usr/bin/tclsh /usr/lib/ribbon/settings/power-idle.tcl
restart = on-failure
restart-delay = 2
restart-limit-count = 5
restart-limit-interval = 60
