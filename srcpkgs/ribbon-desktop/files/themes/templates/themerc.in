# Ribbon labwc theme (palette: @NAME@), generated by ribbon-theme.
# Windows as in the Ribbon mockups: a 40 px title bar in the bar colour,
# title left in Inter SemiBold, line buttons (30 x 28), 12 px corners
# (rc.xml), a 1 px border and a soft 60 px shadow.
border.width: 1
window.titlebar.padding.width: 7
window.titlebar.padding.height: 6

window.active.border.color: @BORDER@
window.inactive.border.color: @BORDER@
window.active.title.bg.color: @BAR@
window.inactive.title.bg.color: @BAR@
window.active.label.text.color: @FG@
window.inactive.label.text.color: @MUTED@
window.label.text.justify: left

window.button.width: 30
window.button.height: 28
window.button.spacing: 0
window.button.hover.bg.color: @PILL@
window.button.hover.bg.corner-radius: 7
window.active.button.unpressed.image.color: @MUTED@
window.inactive.button.unpressed.image.color: @MUTED@

window.active.shadow.size: 60
window.inactive.shadow.size: 40
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050

menu.border.width: 1
menu.border.color: @BORDER@
menu.items.bg.color: @BAR@
menu.items.text.color: @FG@
menu.items.active.bg.color: @PILL@
menu.items.active.text.color: @ACCENT@
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.separator.color: @BORDER@
menu.title.bg.color: @BAR@
menu.title.text.color: @ACCENT@

osd.bg.color: @BAR@
osd.border.color: @ACCENT@
osd.border.width: 1
osd.label.text.color: @FG@
osd.window-switcher.style-classic.item.active.bg.color: @PILL@
osd.window-switcher.style-classic.item.active.border.color: @ACCENT@

snapping.overlay.region.bg.color: @ACCENT@30
snapping.overlay.edge.bg.color: @ACCENT2@30
snapping.overlay.region.border.color: @ACCENT@
snapping.overlay.edge.border.color: @ACCENT2@
