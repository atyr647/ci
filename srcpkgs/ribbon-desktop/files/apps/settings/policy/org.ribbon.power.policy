<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Settings, Power: the power button, the lid, UPower's critical action and level, and the battery charge limit.
     pkexec runs /usr/bin/ribbon-power-helper as root; the helper takes only a fixed list of settings and values.
     An admin's password, kept for a few minutes so several changes in a row ask once. No .rules file: a person
     at the machine is asked, as anyone else is. -->
<policyconfig>
  <vendor>Ribbon OS</vendor>
  <action id="org.ribbon.power">
    <description>Change the power button, lid and battery settings</description>
    <message>Authentication is required to change what the power button, the lid and the battery do for everyone on this computer</message>
    <icon_name>battery</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-power-helper</annotate>
  </action>
</policyconfig>
