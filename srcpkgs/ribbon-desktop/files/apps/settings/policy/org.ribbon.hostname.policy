<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Settings, About: the computer's name. pkexec runs /usr/bin/ribbon-hostname-helper as root; the helper takes one
     name and checks it itself (one RFC 1123 label). An admin's password, kept for a few minutes. No .rules file: a
     person at the machine is asked, as anyone else is. -->
<policyconfig>
  <vendor>Ribbon OS</vendor>
  <action id="org.ribbon.hostname">
    <description>Change this computer's name</description>
    <message>Authentication is required to change this computer's name</message>
    <icon_name>computer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-hostname-helper</annotate>
  </action>
</policyconfig>
