<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Settings, Users. pkexec runs /usr/bin/ribbon-users-helper as root; one action per verb, chosen by the helper's
     first argument (exec.argv1), so the prompt says what is being asked. Adding and removing a user, the
     administrator right, another user's password and logging in without a password ask for an administrator's
     password EVERY time (auth_admin, nothing kept: an unlocked, unattended session must not be able to make an
     account or take one over a few minutes after an unrelated change). Only a user's displayed name is kept
     (auth_admin_keep). Changing your OWN password is not here at all: Settings runs passwd(1) as you, and PAM asks
     for your current password. The helper checks every request again itself (its header has the design); a first
     argument that is none of these falls to pkexec's own generic action, and the helper refuses it.
     No .rules file: a person at the machine is asked, as anyone else is. -->
<policyconfig>
  <vendor>Ribbon OS</vendor>
  <action id="org.ribbon.users.add">
    <description>Add a user</description>
    <message>Authentication is required to add a user to this computer</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">add</annotate>
  </action>
  <action id="org.ribbon.users.remove">
    <description>Remove a user</description>
    <message>Authentication is required to remove a user from this computer</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove</annotate>
  </action>
  <action id="org.ribbon.users.admin">
    <description>Change who is an administrator</description>
    <message>Authentication is required to change who is an administrator of this computer</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">admin</annotate>
  </action>
  <action id="org.ribbon.users.passwd">
    <description>Change another user's password</description>
    <message>Authentication is required to change another user's password</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">passwd</annotate>
  </action>
  <action id="org.ribbon.users.nopass">
    <description>Change who logs in without a password</description>
    <message>Authentication is required to change who may log in without a password</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">nopass</annotate>
  </action>
  <action id="org.ribbon.users.rename">
    <description>Change a user's name</description>
    <message>Authentication is required to change a user's name</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ribbon-users-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rename</annotate>
  </action>
</policyconfig>
