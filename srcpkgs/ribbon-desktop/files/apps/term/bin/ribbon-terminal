#!/bin/sh
# ribbon-terminal - open the terminal: what the desktop's "open a terminal" paths run (Super+Return, the desktop menu).
#
# The terminal is the one chosen in Settings → Default apps, kept the xdg-terminal-exec way: the first entry of
# xdg-terminals.list ($XDG_CONFIG_HOME, each $XDG_CONFIG_DIRS, each data folder's xdg-terminal-exec/) whose desktop
# file is installed ($XDG_DATA_HOME/applications, each $XDG_DATA_DIRS/applications). With no such entry, or when it
# is ribbon-terminal.desktop, the terminal is Ribbon Terminal:
#
#   ribbon-terminal               a new tab (the first one opens the terminal), in the folder it is run from
#                                 when that is not the home folder (Files' "Open terminal here")
#   ribbon-terminal -e CMD ARGS   a tab that runs CMD, with the profile that opens for CMD (the preferences'
#                                 "Opens for")
#   without the Ribbon shell running, plain foot
#
# Another terminal is started by its entry's Exec (field codes dropped); for -e CMD ARGS the command follows the
# entry's X-TerminalArgExec (X-ExecArg and ExecArg, its older names), or what that terminal is known to take, or -e.
# Any other arguments are foot's own and go to foot, as they always have.

# Can the shell's control pipe carry these words whole? It takes one line and splits it at white space
# (shell/main.tcl), so an empty word, white space or a control character in one (a file name) cannot cross it.
whole() {
	for w in "$@"; do
		case $w in "" | *[[:space:][:cntrl:]]*) return 1 ;; esac
	done
	return 0
}

ribbon() {
	case ${1-} in
		"")
			# the folder goes as hex, so that any name survives the shell's control pipe
			d=$(pwd -P 2>/dev/null)
			if [ -n "$d" ] && [ "$d" != "${HOME:-/}" ]; then
				ribbon-term-ctl newin "$(printf %s "$d" | od -An -v -tx1 | tr -d ' \n')" 2>/dev/null && exit 0
			fi
			ribbon-term-ctl new 2>/dev/null && exit 0 ;;
		-e) shift; [ $# -gt 0 ] && whole "$@" && ribbon-term-ctl new "$@" 2>/dev/null && exit 0; exec foot "$@" ;;
	esac
	exec foot "$@"
}

# only "open" and "run this" are another terminal's business
case ${1-} in
	"" | -e) ;;
	*) ribbon "$@" ;;
esac

home=${HOME:-/}
datadirs=${XDG_DATA_HOME:-$home/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
confdirs=${XDG_CONFIG_HOME:-$home/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}

# With no list anywhere it is Ribbon Terminal, and nothing is started to find that out.
listed=
oldifs=$IFS; set -f; IFS=:
for d in $confdirs; do [ -n "$d" ] && [ -f "$d/xdg-terminals.list" ] && listed=1; done
for d in $datadirs; do [ -n "$d" ] && [ -f "$d/xdg-terminal-exec/xdg-terminals.list" ] && listed=1; done
IFS=$oldifs; set +f
[ -n "$listed" ] || ribbon "$@"

# The entries of the lists, one desktop id per line, the most important first. A line that is not a plain desktop
# id (a comment, an option of xdg-terminal-exec, anything with a slash) is not an entry.
entries() {
	(
		set -f; IFS=:
		for d in $confdirs; do [ -n "$d" ] && [ -f "$d/xdg-terminals.list" ] && cat "$d/xdg-terminals.list"; done
		for d in $datadirs; do [ -n "$d" ] && [ -f "$d/xdg-terminal-exec/xdg-terminals.list" ] && cat "$d/xdg-terminal-exec/xdg-terminals.list"; done
	) 2>/dev/null | tr -d '\r' | sed -n 's/^[[:space:]]*\([A-Za-z0-9][A-Za-z0-9._-]*\.desktop\)\(:[A-Za-z0-9._-]*\)\{0,1\}[[:space:]]*$/\1/p'
}

# The desktop file of an id, on stdout: a folder's own file of that name, else one in its subfolders whose path
# is the id with its slashes as dashes (applications/xfce/term.desktop is xfce-term.desktop).
entry_file() {
	(
		set -f; IFS=:
		for d in $datadirs; do
			[ -n "$d" ] || continue
			if [ -f "$d/applications/$1" ] && [ -r "$d/applications/$1" ]; then
				printf '%s\n' "$d/applications/$1"; exit 0
			fi
			case $1 in *-*) ;; *) continue ;; esac
			[ -d "$d/applications" ] || continue
			f=$(find "$d/applications" -mindepth 2 -maxdepth 5 -name '*.desktop' 2>/dev/null | LC_ALL=C sort |
				awk -v pre="$d/applications/" -v id="$1" '{ r = substr($0, length(pre) + 1); gsub("/", "-", r); if (r == id) { print; exit } }')
			if [ -n "$f" ] && [ -f "$f" ] && [ -r "$f" ]; then printf '%s\n' "$f"; exit 0; fi
		done
		exit 1
	)
}

# An entry's launch: the first line is the argument a command follows ("-" when it is not said), then the words
# of Exec, one per line (quotes undone, field codes dropped). Nothing for a hidden entry or one with no Exec.
launch() {
	awk '
		/^\[/ { sub(/[ \t\r]+$/, ""); inside = ($0 == "[Desktop Entry]"); next }
		!inside { next }
		{
			sub(/\r$/, "")
			eq = index($0, "=")
			if (!eq) next
			k = substr($0, 1, eq - 1); v = substr($0, eq + 1)
			sub(/[ \t]+$/, "", k); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
			if (k == "Exec") ex = v
			else if (k == "Hidden") hidden = v
			else if (k == "X-TerminalArgExec") { a1 = v; h1 = 1 }
			else if (k == "X-ExecArg") { a2 = v; h2 = 1 }
			else if (k == "ExecArg") { a3 = v; h3 = 1 }
		}
		END {
			if (ex == "" || hidden == "true") exit 1
			n = 0; word = ""; have = 0; quoted = 0
			for (i = 1; i <= length(ex); i++) {
				c = substr(ex, i, 1)
				if (quoted) {
					if (c == "\\" && i < length(ex)) { i++; word = word substr(ex, i, 1) }
					else if (c == "\"") quoted = 0
					else word = word c
				} else if (c == "\"") { quoted = 1; have = 1 }
				else if (c == " " || c == "\t") { if (have) { words[++n] = word; word = ""; have = 0 } }
				else if (c == "%") {
					i++
					if (substr(ex, i, 1) == "%") { word = word "%"; have = 1 }
				}
				else { word = word c; have = 1 }
			}
			if (have) words[++n] = word
			if (n == 0) exit 1
			if (h1) print "=" a1; else if (h2) print "=" a2; else if (h3) print "=" a3; else print "-"
			for (i = 1; i <= n; i++) print words[i]
		}
	' "$1" 2>/dev/null
}

other=
for id in $(entries); do
	[ "$id" = ribbon-terminal.desktop ] && ribbon "$@"
	file=$(entry_file "$id") || continue
	words=$(launch "$file") || continue
	arg=$(printf '%s\n' "$words" | sed -n 1p)
	first=$(printf '%s\n' "$words" | sed -n 2p)
	# an entry that comes back here is Ribbon Terminal; one whose program is not installed is no entry
	case ${first##*/} in
		ribbon-terminal | ribbon-term-ctl) ribbon "$@" ;;
	esac
	command -v "$first" >/dev/null 2>&1 || continue
	# the caller's arguments are moved behind the terminal's own words
	n=$#
	if [ "$n" -gt 1 ]; then
		# -e CMD ARGS: -e goes, and the terminal's own way to say "run this" takes its place
		shift; n=$((n - 1))
		case $arg in
			=*) run=${arg#=} ;;
			*) case ${first##*/} in
				gnome-terminal | ptyxis) run=-- ;;
				xfce4-terminal | terminator | mate-terminal) run=-x ;;
				*) run=-e ;;
			esac ;;
		esac
	else
		# no command (a bare -e too): only the terminal's own words
		[ "$n" -eq 0 ] || shift
		n=0; run=
	fi
	line=0
	while IFS= read -r w; do
		line=$((line + 1))
		[ "$line" -gt 1 ] && set -- "$@" "$w"
	done <<EOF
$words
EOF
	[ -z "$run" ] || set -- "$@" "$run"
	while [ "$n" -gt 0 ]; do set -- "$@" "$1"; shift; n=$((n - 1)); done
	other=1
	break
done
if [ -n "$other" ]; then exec "$@"; else ribbon "$@"; fi
