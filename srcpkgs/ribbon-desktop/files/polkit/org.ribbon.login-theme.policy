<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The login screen's colours and background (ribbon-theme login,
     ribbon-theme wallpaper login, the Appearance app): pkexec runs
     /usr/lib/ribbon/ribbon-login-theme as root. An admin's password by
     default; 50-ribbon-login-theme.rules lets an admin at the machine
     (active, local, in wheel) do it without one. -->
<policyconfig>
  <vendor>Ribbon OS</vendor>
  <action id="org.ribbon.login-theme">
    <description>Change the login screen's colours and background</description>
    <message>Authentication is required to change the login screen, which everyone on this computer sees</message>
    <icon_name>preferences-desktop-theme</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ribbon/ribbon-login-theme</annotate>
  </action>
</policyconfig>
