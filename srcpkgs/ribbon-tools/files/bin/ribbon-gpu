#!/bin/bash
# ribbon-gpu - detect GPUs and install/configure the right drivers.
# Used by the installer (inside the target system) and afterwards by hand.
set -u
. "${RIBBON_LIB:-/usr/lib/ribbon}/common.sh"

# Package ids (pkg.sh; the base's names are in its pkg-names file). Each
# brings its 32-bit parts, for Steam and Wine.
PKGS_AMD="mesa mesa-vulkan-amd va-amd firmware-amd"
PKGS_INTEL="mesa mesa-vulkan-intel va-intel firmware-intel"
PKGS_NOUVEAU="mesa mesa-vulkan-nouveau firmware-nvidia"
# NVIDIA's 590+ drivers dropped Maxwell/Pascal/Volta; 580 is their last branch.
PKGS_NVIDIA="nvidia va-nvidia vulkan-loader"
# Video decoding: ribbon-wall (and FFmpeg players) use NVDEC through CUDA on
# every proprietary branch; va-nvidia (the VA-API driver, 525 and later) is
# the path for Firefox and the fallback. nouveau decodes in software.
PKGS_NVIDIA580="nvidia580 va-nvidia vulkan-loader"
PKGS_NVIDIA470="nvidia470 vulkan-loader"

usage() {
	cat <<EOF
Usage: ribbon-gpu <command>
  detect               list GPUs and the driver Ribbon recommends for each
  install --auto       install recommended drivers for every GPU found
  install <driver>...  nvidia | nvidia580 | nvidia470 | nouveau | amd | intel
  packages <driver>... the package ids a driver installs (the installer's probe reads them)
  status               show which kernel driver each GPU is using
EOF
}

# Prints "vendor<TAB>driver<TAB>description" for each display controller.
detect() {
	lspci -mm -nn -d ::0300 2>/dev/null
	lspci -mm -nn -d ::0302 2>/dev/null
	lspci -mm -nn -d ::0380 2>/dev/null
}

classify() {
	# Input: lspci -mm -nn lines. Output: vendor<TAB>driver<TAB>name
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		local vend dev
		vend=$(printf '%s' "$line" | awk -F'"' '{print $4}')
		dev=$(printf '%s' "$line" | awk -F'"' '{print $6}')
		case "$vend" in
			*'[10de]'*)
				# pci.ids names include the chip code, e.g. "AD102 [GeForce RTX 4090]".
				case "$dev" in
					TU1*|GA1*|AD1*|GB1*|GB2*|GH1*|GN2*) printf 'nvidia\tnvidia\t%s\n' "$dev" ;;
					GM1*|GM2*|GP1*|GV1*) printf 'nvidia\tnvidia580\t%s\n' "$dev" ;;
					GK1*|GK2*) printf 'nvidia\tnvidia470\t%s\n' "$dev" ;;
					# Fermi and older (nouveau's: no proprietary branch Ribbon ships supports them)
					GF[0-9]*|GT[0-9]*|G[0-9][0-9]*|NV[0-9]*|MCP[0-9]*|C[0-9][0-9]*|CK[0-9]*) printf 'nvidia\tnouveau\t%s\n' "$dev" ;;
					# anything else, "Device [2684]" included (a pci.ids older than the card): a new card
					*) printf 'nvidia\tnvidia\t%s\n' "$dev" ;;
				esac ;;
			*'[1002]'*) printf 'amd\tamd\t%s\n' "$dev" ;;
			*'[8086]'*) printf 'intel\tintel\t%s\n' "$dev" ;;
			*) printf 'other\t-\t%s\n' "$dev" ;;
		esac
	done
}

cmd_detect() {
	detect | classify | while IFS=$'\t' read -r v d n; do
		printf '%-7s %-10s %s\n' "$v" "$d" "$n"
	done
}

# The ISO carries NVIDIA's drivers (and the DKMS toolchain), so they install
# without internet; online, newer builds win (pkg_install does both).
install_pkgs() {
	pkg_install "$@" || die "package installation failed"
}

# Is the NVIDIA kernel module built for any installed kernel? (A DKMS build can fail while the package installs.)
nvidia_module_present() { [ -n "$(find "${RIBBON_ROOT}/usr/lib/modules" -name 'nvidia.ko*' -print -quit 2>/dev/null)" ]; }

# configure_nvidia DRIVER SOLE: SOLE is 1 when NVIDIA is the only GPU. On a laptop with an Intel or AMD GPU too, the
# compositor runs on that GPU and games are offloaded (prime-run): the driver's vendor variables are then NOT set for
# the whole session (GBM_BACKEND=nvidia-drm would put every GBM device, labwc's included, on the NVIDIA backend).
configure_nvidia() {
	local r=${RIBBON_ROOT} driver=${1:-nvidia} sole=${2:-1} have=
	mkdir -p "$r/etc/modprobe.d" "$r/etc/dracut.conf.d" "$r/etc/ribbon/session.d"
	nvidia_module_present && have=1
	{
		cat <<'EOF'
# Written by ribbon-gpu. Kernel modesetting is required for Wayland; the
# video-memory options keep suspend/resume working.
options nvidia_drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
EOF
		# a laptop's NVIDIA GPU powers down when idle (Turing and newer, which is the `nvidia` branch)
		if [ "$driver" = nvidia ] && { [ -e "$r/etc/ribbon/laptop" ] || ribbon-hw is-laptop 2>/dev/null; }; then
			echo 'options nvidia NVreg_DynamicPowerManagement=0x02'
		fi
		# nouveau goes only when there is a module to take its place
		if [ -n "$have" ]; then echo 'blacklist nouveau'; else echo '# no blacklist: the nvidia module is not built for any installed kernel (see ribbon-gpu)'; fi
	} > "$r/etc/modprobe.d/ribbon-nvidia.conf"
	if [ -n "$have" ]; then
		cat > "$r/etc/dracut.conf.d/20-ribbon-nvidia.conf" <<'EOF'
# Written by ribbon-gpu: load NVIDIA early so the console and greeter use it.
add_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "
install_items+=" /etc/modprobe.d/ribbon-nvidia.conf "
EOF
	else
		rm -f "$r/etc/dracut.conf.d/20-ribbon-nvidia.conf"
		warn "the NVIDIA kernel module is not built for any installed kernel (DKMS failed?): nouveau stays enabled; run: sudo ribbon gpu install $driver"
	fi
	{
		echo '# Written by ribbon-gpu (NVIDIA proprietary driver)'
		if [ "$sole" = 1 ]; then
			echo 'export GBM_BACKEND=nvidia-drm'
			echo 'export __GLX_VENDOR_LIBRARY_NAME=nvidia'
			echo 'export LIBVA_DRIVER_NAME=nvidia'
			echo 'export NVD_BACKEND=direct'
		else
			echo '# another GPU is the desktop'"'"'s: the vendor variables are set per program by prime-run, not here'
		fi
		echo '# Shader cache: large enough for big games (Star Citizen alone uses several GB)'
		echo 'export __GL_SHADER_DISK_CACHE_SIZE=12000000000'
		echo 'export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1'
	} > "$r/etc/ribbon/session.d/20-nvidia.sh"
	# elogind runs these around suspend/hibernate (replaces nvidia-suspend.service).
	mkdir -p "$r/etc/elogind/system-sleep"
	cat > "$r/etc/elogind/system-sleep/ribbon-nvidia" <<'EOF'
#!/bin/sh
# Written by ribbon-gpu: save/restore NVIDIA video memory across sleep.
command -v nvidia-sleep.sh >/dev/null 2>&1 || exit 0
case "$1/$2" in
	pre/suspend|pre/hybrid-sleep) exec nvidia-sleep.sh suspend ;;
	pre/hibernate) exec nvidia-sleep.sh hibernate ;;
	post/*) exec nvidia-sleep.sh resume ;;
esac
EOF
	chmod 755 "$r/etc/elogind/system-sleep/ribbon-nvidia"
	cmdline_add nvidia_drm.modeset=1 nvidia_drm.fbdev=1
}

# The other way: a driver set with no NVIDIA proprietary driver (a recovery with nouveau, a disk moved to an AMD
# machine) must not leave the proprietary setup behind: nouveau blacklisted, GBM_BACKEND=nvidia-drm exported to the
# session, the NVIDIA modules in the initramfs.
undo_nvidia() {
	local r=${RIBBON_ROOT} f gone=
	for f in "$r/etc/modprobe.d/ribbon-nvidia.conf" "$r/etc/dracut.conf.d/20-ribbon-nvidia.conf" \
		"$r/etc/ribbon/session.d/20-nvidia.sh" "$r/etc/elogind/system-sleep/ribbon-nvidia"; do
		[ -e "$f" ] && { rm -f "$f"; gone=1; }
	done
	cmdline_remove nvidia_drm.modeset=1 nvidia_drm.fbdev=1
	[ -z "$gone" ] || msg "removed the proprietary NVIDIA setup (nouveau is no longer blacklisted)"
}

configure_hybrid() {
	# Laptop with an iGPU plus a discrete GPU: provide `prime-run <cmd>`.
	local r=${RIBBON_ROOT}
	mkdir -p "$r/usr/local/bin"
	cat > "$r/usr/local/bin/prime-run" <<'EOF'
#!/bin/sh
# Written by ribbon-gpu: run a program on the discrete GPU.
# the proprietary driver's own file says it is loaded (a laptop's NVIDIA GPU is a "3D controller", not a "VGA" one)
if [ -e /proc/driver/nvidia/version ]; then
	export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only
else
	export DRI_PRIME=1
fi
exec "$@"
EOF
	chmod 755 "$r/usr/local/bin/prime-run"
}

# The package list for drivers (one line), shared with the installer.
driver_pkgs() {
	local d pkgs=""
	for d; do
		case "$d" in
			nvidia) pkgs="$pkgs $PKGS_NVIDIA" ;;
			nvidia580) pkgs="$pkgs $PKGS_NVIDIA580" ;;
			nvidia470) pkgs="$pkgs $PKGS_NVIDIA470" ;;
			nouveau) pkgs="$pkgs $PKGS_NOUVEAU" ;;
			amd) pkgs="$pkgs $PKGS_AMD" ;;
			intel) pkgs="$pkgs $PKGS_INTEL" ;;
			*) die "unknown driver '$d'" ;;
		esac
	done
	# shellcheck disable=SC2086
	printf '%s\n' $pkgs | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/ $//'
	echo
}

# One driver per vendor (the NVIDIA branches exclude each other, and so does nouveau next to a proprietary driver):
# the newest branch that every NVIDIA card in the machine works with, said when a card is left out.
reduce_drivers() {
	local d new='' b580='' b470='' nouveau='' keep=() pick=''
	for d; do
		case "$d" in
			nvidia) new=1 ;; nvidia580) b580=1 ;; nvidia470) b470=1 ;; nouveau) nouveau=1 ;;
			*) keep+=("$d") ;;
		esac
	done
	if [ -n "$new$b580" ]; then
		# 580 is the last branch with Maxwell, Pascal and Volta; it runs the newer cards too
		[ -n "$b580" ] && pick=nvidia580 || pick=nvidia
		[ -z "$b470" ] || warn "a Kepler NVIDIA card is in this machine too: the $pick driver does not support it (it needs nvidia470, which cannot be installed beside it)"
		[ -z "$nouveau" ] || warn "an older NVIDIA card that only nouveau supports is in this machine too: the proprietary driver takes over, and nouveau is blacklisted"
	elif [ -n "$b470" ]; then
		pick=nvidia470
		[ -z "$nouveau" ] || warn "an older NVIDIA card that only nouveau supports is in this machine too: nvidia470 takes over, and nouveau is blacklisted"
	elif [ -n "$nouveau" ]; then
		pick=nouveau
	fi
	printf '%s\n' "${keep[@]}" ${pick:+"$pick"}
}

cmd_install() {
	local drivers=() pkgs="" d vendors nv='' nvn=0 sole=1
	if [ "${1:-}" = "--auto" ] || [ $# -eq 0 ]; then
		mapfile -t drivers < <(detect | classify | cut -f2 | grep -v '^-$' | sort -u)
		[ ${#drivers[@]} -gt 0 ] || { warn "no GPU detected; installing generic Mesa"; drivers=(amd); }
		mapfile -t drivers < <(reduce_drivers "${drivers[@]}")
	else
		drivers=("$@")
		for d in "${drivers[@]}"; do case "$d" in nvidia|nvidia580|nvidia470|nouveau) nvn=$((nvn + 1)) ;; esac; done
		[ "$nvn" -le 1 ] || die "choose one NVIDIA driver (nvidia, nvidia580, nvidia470 or nouveau), not ${nvn}"
	fi
	pkgs=$(driver_pkgs "${drivers[@]}") || exit 1
	# CPU microcode (AMD's is in firmware-amd, already in ribbon-base).
	grep -q GenuineIntel /proc/cpuinfo 2>/dev/null && pkgs="$pkgs microcode-intel"

	msg "Installing GPU drivers: ${drivers[*]}"
	# shellcheck disable=SC2046,SC2086
	install_pkgs $(printf '%s\n' $pkgs | sort -u)

	# GPU vendors that are present (a controller of another vendor, a VM's, is no second GPU)
	vendors=$(detect | classify | cut -f1 | grep -E '^(nvidia|amd|intel)$' | sort -u | wc -l)
	for d in "${drivers[@]}"; do case "$d" in nvidia|nvidia580|nvidia470) nv=$d ;; esac; done
	if [ -n "$nv" ]; then
		[ "$vendors" -gt 1 ] && sole=0
		configure_nvidia "$nv" "$sole"
	else
		undo_nvidia
	fi
	[ "$vendors" -gt 1 ] && configure_hybrid
	regen_initramfs   # and the boot menu
	ok "GPU drivers installed (reboot to use them)"
}

cmd_status() {
	lspci -k -d ::0300; lspci -k -d ::0302; lspci -k -d ::0380
	[ -r /proc/driver/nvidia/version ] && head -n1 /proc/driver/nvidia/version
}

case "${1:-}" in
	detect) cmd_detect ;;
	install) need_root; shift; cmd_install "$@" ;;
	status) cmd_status ;;
	packages) shift; driver_pkgs "$@" ;;
	-h|--help|"") usage ;;
	*) usage >&2; exit 2 ;;
esac
