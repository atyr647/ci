+	size_t			len = optionName ? strlen(optionName) : 0;
+	struct fd_msg*	m;
+	char			num[TCL_INTEGER_SPACE + 2];
+
+	// -passfds: read-only, set by unix_sockets::connect and ::listen
+	if (len == 0 || (len > 1 && strncmp(optionName, "-passfds", len) == 0)) {
+		if (len == 0) Tcl_DStringAppendElement(dsPtr, "-passfds");
+		Tcl_DStringAppendElement(dsPtr, con->passfds ? "1" : "0");
