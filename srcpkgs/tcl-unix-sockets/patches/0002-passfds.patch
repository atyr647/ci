+# uds-8.*: Passing descriptors (-passfds) <<<
+# The sending side is a python3 peer (socket.send_fds).  Each step is
+# hexdata:tag,tag - one sendmsg of those bytes carrying the read end of a
+# pipe per tag, which reads back as the tag - or sleep:seconds.  In "serve"
+# mode it listens on path and prints "ready", otherwise it connects to path.
+::tcltest::testConstraint sendfds [expr {
+	![catch {exec python3 -c {import socket; socket.send_fds}}]
+}]
+
+set fdpeer {
+import os, socket, sys, time
+mode, path = sys.argv[1:3]
+s = socket.socket(socket.AF_UNIX)
+if mode == "serve":
+	s.bind(path)
+	s.listen(1)
+	print("ready", flush=True)
+	s = s.accept()[0]
+else:
+	s.connect(path)
+for step in sys.argv[3:]:
+	what, _, arg = step.partition(":")
+	if what == "sleep":
+		time.sleep(float(arg))
+		continue
+	fds = []
+	for tag in filter(None, arg.split(",")):
+		r, w = os.pipe()
+		os.write(w, (tag + "\n").encode())
+		os.close(w)
+		fds.append(r)
+	if fds:
+		socket.send_fds(s, [bytes.fromhex(what)], fds)
+	else:
+		s.sendall(bytes.fromhex(what))
+	for fd in fds:
+		os.close(fd)
+s.close()
+}
+
+proc fdpeer {mode path args} { # Start the peer; close the result to wait for it
+	set peer [open |[list python3 -c $::fdpeer $mode $path {*}$args] r]
+	if {$mode eq "serve"} {gets $peer}
+	set peer
+}
+proc msg {data args} {string cat [binary encode hex $data] : [join $args ,]}
+proc tags chans {lmap c $chans {set tag [gets $c]; close $c; set tag}}
+proc msgtags msgs {lmap m $msgs {list [lindex $m 0] [tags [lindex $m 1]]}}
+proc nfds {} {llength [glob -nocomplain -directory /proc/self/fd *]}
+proc accept_one path { # A -passfds listener, and the first connection to it
+	set ::accepted {}
+	set listen [unix_sockets::listen $path [list apply {con {set ::accepted $con}}] -passfds 1]
+	list $listen
+}
+
+test uds-8.1 {-passfds: descriptors read with gets, none lost, in order} -constraints sendfds -body { #<<<
+	set listen [accept_one [file join $sockdir uds-8.1]]
+	set peer [fdpeer connect [file join $sockdir uds-8.1] \
+		[msg one\n] [msg two\n p1] [msg three\n] [msg four\n p2 p3] [msg five\n p4]]
+	vwait ::accepted
+	chan configure $::accepted -blocking 1
+	set out {}
+	foreach _ {1 2 3 4 5} {
+		lappend out [gets $::accepted] [tags [unix_sockets::fds $::accepted]]
+	}
+	set out
+} -cleanup {
+	catch {close $peer}
+	catch {close $::accepted}
+	catch {close $listen}
+	unset -nocomplain listen peer out ::accepted
+} -result {one {} two p1 three {} four {p2 p3} five p4}
