+	if (Tcl_GetChannelType(channel) != &unix_socket_channel_type || !con->passfds || con->accept_handler) {
+		Tcl_SetErrorCode(interp, "UNIX_SOCKETS", "PASSFDS", NULL);
+		THROW_PRINTF_LABEL(finally, code, "channel \"%s\" is not a unix_sockets connection opened with -passfds 1",
+				Tcl_GetString(objv[A_CHANNEL]));
+	}
+
+	// The bytes the script has read: under a transform, all that was read
+	top = Tcl_GetTopChannel(channel);
+	upto = con->received - (top == channel ? Tcl_InputBuffered(channel) : 0);
+
+	for (m = con->fds_head; m && (all || m->end <= upto); m = m->next) {
+		if (m->lost) {
+			// Report it once; the descriptors that did arrive stay queued
+			m->lost = 0;
+			Tcl_SetErrorCode(interp, "UNIX_SOCKETS", "CTRUNC", NULL);
+			THROW_PRINTF_LABEL(finally, code, "file descriptors sent with the message ending at offset %"
+					TCL_LL_MODIFIER "d were lost: the kernel could not pass them all (the open file limit?)",
+					(Tcl_WideInt)m->end);
+		}
+	}
+
+	replace_tclobj(&res, Tcl_NewListObj(0, NULL));
+	while ((m = con->fds_head) && (all || m->end <= upto)) {
+		Tcl_Obj*	channels = messages ? Tcl_NewListObj(0, NULL) : res;
+
+		for (int i=0; i<m->nfd; i++) {
+			Tcl_Obj*	name = fd_channel(interp, m->fds[i]);
+			if (name) Tcl_ListObjAppendElement(NULL, channels, name);
+		}
+		m->nfd = 0;		// now owned by their channels
+		if (messages) {
+			Tcl_Obj*	pair[2] = {Tcl_NewWideIntObj(m->end), channels};
+			Tcl_ListObjAppendElement(NULL, res, Tcl_NewListObj(2, pair));
+		}
+
+		if (NULL == (con->fds_head = m->next))
+			con->fds_tail = NULL;
+		free_fd_msg(m);
+	}
+
+	Tcl_SetObjResult(interp, res);
+
+finally:
+	replace_tclobj(&res, NULL);
+	return code;
+}
