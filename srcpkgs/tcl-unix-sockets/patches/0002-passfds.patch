+//>>>
+static Tcl_Obj* fd_channel(Tcl_Interp* interp, int fd) //<<<
+{
+	// A Tcl channel for a received descriptor, readable and/or writable as it
+	// was opened, and in the blocking mode it shares with the sender
+	int				fl = fcntl(fd, F_GETFL);
+	int				mode;
+	Tcl_Channel		channel;
+
+	switch (fl & O_ACCMODE) {
+		case O_RDONLY:	mode = TCL_READABLE;					break;
+		case O_WRONLY:	mode = TCL_WRITABLE;					break;
+		default:		mode = TCL_READABLE | TCL_WRITABLE;		break;
+	}
+
+	channel = Tcl_MakeFileChannel((ClientData)(intptr_t)fd, mode);
+	if (channel == NULL) {
+		close(fd);
+		return NULL;
+	}
+	Tcl_RegisterChannel(interp, channel);
+	if (fl != -1 && (fl & O_NONBLOCK))
+		(void)Tcl_SetChannelOption(NULL, channel, "-blocking", "0");
+
+	return Tcl_NewStringObj(Tcl_GetChannelName(channel), -1);
+}
