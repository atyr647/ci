+//>>>
+/*
+ * A descriptor passed with SCM_RIGHTS travels with the bytes of the sendmsg
+ * that carried it, and the kernel hands it to the first read that takes some
+ * of those bytes.  A plain read() can't take it, so the kernel closes it.
+ * With -passfds every read is a recvmsg, and each message's descriptors are
+ * queued in order, tagged with the stream offset just past the bytes they
+ * came with.  The kernel ends a read right after a message that carries
+ * descriptors, so that is where the message ended (unless it was larger than
+ * the read, then it is a point inside it).  Where the message began can't be
+ * known: the read may start with earlier bytes.
+ */
+static int recv_passfds(uds_state* con, char* buf, int bufSize, int* errorCodePtr) //<<<
+{
+	union {
+		struct cmsghdr	align;
+		char			buf[CMSG_SPACE(MAX_PASSFDS * sizeof(int))];
+	}					ctl;
+	struct iovec		iov = {.iov_base = buf, .iov_len = (size_t)bufSize};
+	struct msghdr		msg = {
+		.msg_iov		= &iov,
+		.msg_iovlen		= 1,
+		.msg_control	= ctl.buf,
+		.msg_controllen	= sizeof(ctl.buf),
+	};
+	struct cmsghdr*		cmsg;
+	struct fd_msg*		m;
+	ssize_t				got;
+	int					flags = 0, nfd = 0;
+
+#ifdef MSG_CMSG_CLOEXEC
+	flags |= MSG_CMSG_CLOEXEC;
+#endif
+	got = recvmsg(con->fd, &msg, flags);
+	if (got == -1) {
+		*errorCodePtr = Tcl_GetErrno();
+		return -1;
+	}
+	con->received += got;
+
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg; cmsg = CMSG_NXTHDR(&msg, cmsg))
+		if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS)
+			nfd += (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+
+	if (nfd == 0 && !(msg.msg_flags & MSG_CTRUNC))
+		return (int)got;
+
+	m = (struct fd_msg*)ckalloc(offsetof(struct fd_msg, fds) + (nfd ? nfd : 1) * sizeof(int));
+	*m = (struct fd_msg){
+		.end	= con->received,
+		.lost	= (msg.msg_flags & MSG_CTRUNC) != 0,
+	};
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+		if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS) {
+			int		c = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+			memcpy(m->fds + m->nfd, CMSG_DATA(cmsg), c * sizeof(int));
+			m->nfd += c;
+		}
+	}
+#ifndef MSG_CMSG_CLOEXEC
+	for (int i=0; i<m->nfd; i++)
+		(void)fcntl(m->fds[i], F_SETFD, FD_CLOEXEC);
+#endif
+
+	if (con->fds_tail)
+		con->fds_tail->next = m;
+	else
+		con->fds_head = m;
+	con->fds_tail = m;
+
+	return (int)got;
+}
+
