+
+	// -fdqueue: read-only.  For other extensions that take the connection
+	// over (they dup the descriptors, which stay owned by this channel):
+	// {} without -passfds, else the bytes read from the socket so far,
+	// then {offset lost {fd ...}} for each queued message, oldest first.
+	if (len == 0 || (len > 1 && strncmp(optionName, "-fdqueue", len) == 0)) {
+		if (len == 0) {
+			Tcl_DStringAppendElement(dsPtr, "-fdqueue");
+			Tcl_DStringStartSublist(dsPtr);
+		}
+		if (con->passfds && con->accept_handler == NULL) {
+			snprintf(num, sizeof(num), "%" TCL_LL_MODIFIER "d", (Tcl_WideInt)con->received);
+			Tcl_DStringAppendElement(dsPtr, num);
+			for (m = con->fds_head; m; m = m->next) {
+				Tcl_DStringStartSublist(dsPtr);
+				snprintf(num, sizeof(num), "%" TCL_LL_MODIFIER "d", (Tcl_WideInt)m->end);
+				Tcl_DStringAppendElement(dsPtr, num);
+				Tcl_DStringAppendElement(dsPtr, m->lost ? "1" : "0");
+				Tcl_DStringStartSublist(dsPtr);
+				for (int i=0; i<m->nfd; i++) {
+					snprintf(num, sizeof(num), "%d", m->fds[i]);
+					Tcl_DStringAppendElement(dsPtr, num);
+				}
+				Tcl_DStringEndSublist(dsPtr);
+				Tcl_DStringEndSublist(dsPtr);
+			}
+		}
+		if (len == 0) Tcl_DStringEndSublist(dsPtr);
+		else return TCL_OK;
+	}
+
+	if (len == 0) return TCL_OK;
+	return Tcl_BadChannelOption(interp, optionName, "fdqueue passfds");
+}
