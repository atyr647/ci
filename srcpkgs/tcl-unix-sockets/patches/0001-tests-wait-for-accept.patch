From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ribbon OS maintainers <ribbon@localhost>
Date: Fri, 6 Nov 2026 23:59:00 +0000
Subject: [PATCH 1/2] tests: wait for the accept in uds-5.2 and uds-6.2

One update does not always run the accept handler before the test uses
::accepted. Run after uds-6.1, uds-6.2 fails about one time in three
with 'can not find channel named ""'. Wait for ::accepted instead.
---
 tests/uds.test | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/uds.test b/tests/uds.test
index 6f4cf01..ef3c5cd 100644
--- a/tests/uds.test
+++ b/tests/uds.test
@@ -247,7 +247,7 @@ test uds-5.2 {transfer accepted channel to child interp} -body { #<<<
 
 	set client [unix_sockets::connect [file join $sockdir uds-5.2]]
 	chan configure $client -blocking 1
-	update ;# trigger accept
+	vwait ::accepted ;# one update may not be enough to run the accept handler
 
 	interp create child
 	interp transfer {} $::accepted child
@@ -319,7 +319,7 @@ test uds-6.2 {transfer accepted channel to worker thread} -constraints thread -b
 
 	set client		[unix_sockets::connect [file join $sockdir uds-6.2]]
 	chan configure $client -blocking 1
-	update ;# trigger accept
+	vwait ::accepted ;# one update may not be enough to run the accept handler
 
 	set tid			[thread::create {thread::wait}]
 	thread::transfer $tid $::accepted
